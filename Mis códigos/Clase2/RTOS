#include <Arduino_FreeRTOS.h>
#define LED1 8
#define LED2 9
#define LED3 10

void blinkLED1( void *pvParameters );
void blinkLED2( void *pvParameters );
void blinkLED3( void *pvParameters );

void setup() {
  xTaskCreate(blinkLED1, "LED1", 128, NULL, 3, NULL);
  xTaskCreate(blinkLED2, "LED2", 128, NULL, 3, NULL);
  xTaskCreate(blinkLED3, "LED3", 128, NULL, 3, NULL);
}

void loop(){
}

void blinkLED1(void *pvParameters){
  pinMode(LED1, OUTPUT);

  for (;;){
    digitalWrite(LED1, HIGH);
    vTaskDelay( 1000 / portTICK_PERIOD_MS );
    digitalWrite(LED1, LOW);
    vTaskDelay( 1000 / portTICK_PERIOD_MS );
  }
}

void blinkLED2(void *pvParameters){
  pinMode(LED2, OUTPUT);

  for (;;){
    digitalWrite(LED2, HIGH);
    vTaskDelay( 40 / portTICK_PERIOD_MS );
    digitalWrite(LED2, LOW);
    vTaskDelay( 40 / portTICK_PERIOD_MS );
  }
}
void blinkLED3(void *pvParameters){
  pinMode(LED3, OUTPUT);

  for (;;){
    digitalWrite(LED3, HIGH);
    vTaskDelay( 500 / portTICK_PERIOD_MS );
    digitalWrite(LED3, LOW);
    vTaskDelay( 500 / portTICK_PERIOD_MS );
  }
}